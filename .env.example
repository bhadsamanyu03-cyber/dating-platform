APP_ENVIRONMENT=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_NAME=dating-platform-api
API_PREFIX=/api/v1
POSTGRES_DB=dating_platform
POSTGRES_USER=dating_platform
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+asyncpg://dating_platform:change-me-locally@postgres:5432/dating_platform
REDIS_URL=redis://redis:6379/0
BACKEND_CORS_ORIGINS=["http://localhost:8081"]
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]
JWT_SECRET_KEY=replace-before-production-with-a-strong-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
EMAIL_TOKEN_HOURS=24
PASSWORD_RESET_MINUTES=30
COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=10
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=dating-platform
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=us-east-1
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_PATH=/tmp/dating-platform-media
MEDIA_UPLOAD_CHUNK_BYTES=1048576
MEDIA_IMAGE_MAX_UPLOAD_BYTES=26214400
MEDIA_VIDEO_MAX_UPLOAD_BYTES=104857600
MEDIA_STORAGE_TIMEOUT_SECONDS=30
MEDIA_STORAGE_RETRY_ATTEMPTS=3
MEDIA_SIGNED_URL_EXPIRY_SECONDS=900
MEDIA_IMAGE_LARGE_PX=2048
MEDIA_IMAGE_MEDIUM_PX=1280
MEDIA_IMAGE_SMALL_PX=640
MEDIA_THUMBNAIL_PX=320
MEDIA_IMAGE_JPEG_QUALITY=85
MEDIA_IMAGE_WEBP_QUALITY=82
MEDIA_VIDEO_DISPLAY_PX=1280
MEDIA_VIDEO_THUMBNAIL_PX=640
MEDIA_VIDEO_THUMBNAIL_SECOND=1
MEDIA_PROCESSING_STALE_SECONDS=3600
