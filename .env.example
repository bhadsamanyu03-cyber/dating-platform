APP_ENVIRONMENT=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_NAME=dating-platform-api
API_PREFIX=/api/v1
POSTGRES_DB=dating_platform
POSTGRES_USER=dating_platform
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+asyncpg://dating_platform:change-me-locally@postgres:5432/dating_platform
REDIS_URL=redis://redis:6379/0
BACKEND_CORS_ORIGINS=["http://localhost:8081"]
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]
JWT_SECRET_KEY=replace-before-production-with-a-strong-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
EMAIL_TOKEN_HOURS=24
PASSWORD_RESET_MINUTES=30
COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=10
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=dating-platform
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
